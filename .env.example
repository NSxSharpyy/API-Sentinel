# API-Sentinel local development configuration
# Copy to .env and explicitly export these variables before starting the API.
# Do not put real credentials or secrets in this file.

# Database
DATABASE_URL=sqlite:///./api_sentinel.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./api_sentinel.db

# API-only mode: packet capture disabled
API_SENTINEL_CAPTURE_ENABLED=0

# Application queues
API_SENTINEL_QUEUE_MAX_SIZE=10000
API_SENTINEL_BLOCK_VERDICT_QUEUE_MAX_SIZE=1024

# Persistence
API_SENTINEL_PERSISTENCE_QUEUE_MAX_SIZE=12000
API_SENTINEL_PERSISTENCE_BATCH_MAX_SIZE=32

# ZeroMQ
API_SENTINEL_ZMQ_SNDHWM=1000
API_SENTINEL_ZMQ_RCVHWM=1000

# Optional blocklist integrations: disabled
API_SENTINEL_BLOCKLIST_DROP_AUDIT_ENABLED=0
API_SENTINEL_BLOCKLIST_SYNC_ENABLED=0
API_SENTINEL_BLOCKLIST_POLICY_ENABLED=0
API_SENTINEL_BLOCKLIST_BATCH_SIZE=5
API_SENTINEL_BLOCKLIST_VERDICT_ENDPOINT=tcp://127.0.0.1:5558
API_SENTINEL_BLOCKLIST_ALLOWED_SOURCE_IPS=
API_SENTINEL_BLOCKLIST_VERDICT_TTL_SECONDS=60

# Optional memory profiling: disabled
API_SENTINEL_MEMORY_PROFILE_ENABLED=0
API_SENTINEL_TRACEMALLOC_ENABLED=0
API_SENTINEL_TRACEMALLOC_FRAMES=10
API_SENTINEL_MEMORY_PROFILE_INTERVAL_SECONDS=60
API_SENTINEL_MEMORY_PROFILE_DRAIN_TIMEOUT_SECONDS=120
API_SENTINEL_MEMORY_PROFILE_QUIET_PERIOD_SECONDS=2
API_SENTINEL_MEMORY_PROFILE_OUTPUT_DIR=artifacts/day28
